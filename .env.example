# ---------------------------------------------------------------------------
# CREDENCIAIS DO ROBÔ
# ---------------------------------------------------------------------------
# No seu computador: copie este arquivo para ".env" e preencha.
# No GitHub Actions: cadastre cada linha em Settings > Secrets and variables.
#   IG_USER_ID, IG_TOKEN, TIKTOK_TOKEN  -> aba "Secrets"
#   URL_BASE_PUBLICA, TIKTOK_PRIVACIDADE -> aba "Variables"
# ---------------------------------------------------------------------------

# Onde as imagens ficam publicamente acessíveis (GitHub Pages).
# Troque SEU-USUARIO pelo seu usuário do GitHub.
URL_BASE_PUBLICA=https://SEU-USUARIO.github.io/lotofacil-bot

# --- Instagram (Meta for Developers) ---
# ID numérico da conta profissional do Instagram (NÃO é o @arroba)
IG_USER_ID=
# Token de acesso. Dura 60 dias; renove com:
#   python -m src.publicar --renovar-token
IG_TOKEN=
# Caminho de publicação:
#   instagram_login  -> NÃO precisa de página do Facebook (padrão, recomendado)
#   pagina_facebook  -> caminho antigo, via página vinculada
IG_MODO=instagram_login
# Versão da API (deixe como está se não souber)
IG_VERSAO_API=v23.0

# --- TikTok (TikTok for Developers) ---
TIKTOK_TOKEN=
# Enquanto o app não passar pela auditoria do TikTok, só SELF_ONLY funciona.
# Depois de aprovado, troque para PUBLIC_TO_EVERYONE.
TIKTOK_PRIVACIDADE=SELF_ONLY

# --- Coleta ---
# Coloque 0 apenas se der erro de certificado SSL ao acessar a Caixa
LOTOFACIL_SSL=1
